<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cdt" model="ir.module.category">
        <field name="name">CDT Maintenance</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_cdt_technicien" model="res.groups">
        <field name="name">Technicien</field>
        <field name="category_id" ref="module_category_cdt"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cdt_commercial" model="res.groups">
        <field name="name">Commercial</field>
        <field name="category_id" ref="module_category_cdt"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cdt_chef" model="res.groups">
        <field name="name">Chef de maintenance</field>
        <field name="category_id" ref="module_category_cdt"/>
        <field name="implied_ids" eval="[(4, ref('group_cdt_technicien')), (4, ref('group_cdt_commercial'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
