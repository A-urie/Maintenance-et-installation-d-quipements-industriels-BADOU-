<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cdt_intervention_list" model="ir.ui.view">
        <field name="name">cdt.intervention.list</field>
        <field name="model">cdt.intervention</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_planifiee"/>
                <field name="equipement_id"/>
                <field name="client_id"/>
                <field name="technicien_ids" widget="many2many_tags"/>
                <field name="duree"/>
                <field name="statut" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cdt_intervention_form" model="ir.ui.view">
        <field name="name">cdt.intervention.form</field>
        <field name="model">cdt.intervention</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_demarrer" string="Démarrer" type="object" class="btn-primary" invisible="statut != 'planifiee'"/>
                    <button name="action_cloturer" string="Clôturer" type="object" class="btn-primary" invisible="statut != 'en_cours'"/>
                    <field name="statut" widget="statusbar" statusbar_visible="planifiee,en_cours,terminee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="INT-0001"/></h1>
                    </div>
                    <group>
                        <group string="Contexte">
                            <field name="demande_id"/>
                            <field name="equipement_id"/>
                            <field name="client_id"/>
                            <field name="technicien_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Planning">
                            <field name="date_planifiee"/>
                            <field name="duree_prevue"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="duree"/>
                        </group>
                    </group>
                    <group string="Fiche d'intervention">
                        <field name="cause_panne"/>
                        <field name="travaux"/>
                        <field name="cout"/>
                        <field name="validation_client"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cdt_intervention_calendar" model="ir.ui.view">
        <field name="name">cdt.intervention.calendar</field>
        <field name="model">cdt.intervention</field>
        <field name="arch" type="xml">
            <calendar string="Planning des interventions" date_start="date_planifiee" date_delay="duree_prevue" color="equipement_id" mode="week" event_open_popup="true" quick_create="0">
                <field name="name"/>
                <field name="equipement_id"/>
                <field name="technicien_ids" widget="many2many_tags"/>
                <field name="statut"/>
            </calendar>
        </field>
    </record>

    <record id="view_cdt_intervention_search" model="ir.ui.view">
        <field name="name">cdt.intervention.search</field>
        <field name="model">cdt.intervention</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipement_id"/>
                <field name="client_id"/>
                <filter name="filtre_planifiees" string="Planifiées" domain="[('statut', '=', 'planifiee')]"/>
                <filter name="filtre_en_cours" string="En cours" domain="[('statut', '=', 'en_cours')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="groupe_equipement" string="Équipement" context="{'group_by': 'equipement_id'}"/>
                    <filter name="groupe_statut" string="Statut" context="{'group_by': 'statut'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdt_intervention" model="ir.actions.act_window">
        <field name="name">Interventions</field>
        <field name="res_model">cdt.intervention</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_cdt_planning" model="ir.actions.act_window">
        <field name="name">Planning</field>
        <field name="res_model">cdt.intervention</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <menuitem id="menu_cdt_interventions" name="Interventions" parent="menu_cdt_root"
              action="action_cdt_intervention" sequence="30"/>
    <menuitem id="menu_cdt_planning" name="Planning" parent="menu_cdt_root"
              action="action_cdt_planning" sequence="25"/>
</odoo>