<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cdt_alerte_list" model="ir.ui.view">
        <field name="name">cdt.alerte.list</field>
        <field name="model">cdt.alerte</field>
        <field name="arch" type="xml">
            <list decoration-muted="traitee">
                <field name="name"/>
                <field name="type_alerte" widget="badge"/>
                <field name="equipement_id"/>
                <field name="piece_id"/>
                <field name="date_echeance"/>
                <field name="traitee"/>
                <button name="action_traiter" type="object" string="Marquer traitée" icon="fa-check" invisible="traitee"/>
            </list>
        </field>
    </record>

    <record id="view_cdt_alerte_form" model="ir.ui.view">
        <field name="name">cdt.alerte.form</field>
        <field name="model">cdt.alerte</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_traiter" string="Marquer traitée" type="object" class="btn-primary" invisible="traitee"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type_alerte"/>
                        <field name="equipement_id"/>
                        <field name="piece_id"/>
                        <field name="date_echeance"/>
                        <field name="traitee"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cdt_alerte_search" model="ir.ui.view">
        <field name="name">cdt.alerte.search</field>
        <field name="model">cdt.alerte</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filtre_a_traiter" string="À traiter" domain="[('traitee', '=', False)]"/>
                <filter name="filtre_garantie" string="Garanties" domain="[('type_alerte', '=', 'garantie')]"/>
                <filter name="filtre_visite" string="Visites en retard" domain="[('type_alerte', '=', 'visite')]"/>
                <filter name="filtre_stock" string="Stock bas" domain="[('type_alerte', '=', 'stock')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="groupe_type" string="Type" context="{'group_by': 'type_alerte'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdt_alerte" model="ir.actions.act_window">
        <field name="name">Alertes</field>
        <field name="res_model">cdt.alerte</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filtre_a_traiter': 1}</field>
    </record>

    <record id="action_cdt_scanner_alertes" model="ir.actions.server">
        <field name="name">Générer les alertes</field>
        <field name="model_id" ref="model_cdt_alerte"/>
        <field name="state">code</field>
        <field name="code">model.scanner()
action = env.ref('cdt_maintenance.action_cdt_alerte').read()[0]</field>
    </record>

    <menuitem id="menu_cdt_alertes" name="Alertes" parent="menu_cdt_root"
              action="action_cdt_alerte" sequence="50"/>
    <menuitem id="menu_cdt_scanner" name="Générer les alertes" parent="menu_cdt_root"
              action="action_cdt_scanner_alertes" sequence="55"/>
</odoo>