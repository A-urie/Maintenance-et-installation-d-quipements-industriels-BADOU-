<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_installation_pv" model="ir.actions.report">
        <field name="name">Procès-verbal de réception</field>
        <field name="model">cdt.installation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cdt_maintenance.report_installation_pv_document</field>
        <field name="report_file">cdt_maintenance.report_installation_pv_document</field>
        <field name="print_report_name">'PV_%s' % (object.name or 'installation')</field>
        <field name="binding_model_id" ref="model_cdt_installation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_installation_pv_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Procès-verbal de réception</h2>
                        <p class="text-center">Dossier d'installation <span t-field="o.name"/></p>

                        <table class="table table-sm mt-4">
                            <tr>
                                <th style="width: 30%;">Client</th>
                                <td><span t-field="o.client_id"/></td>
                            </tr>
                            <tr>
                                <th>Équipement</th>
                                <td><span t-field="o.equipement_id"/></td>
                            </tr>
                            <tr>
                                <th>Numéro de série</th>
                                <td><span t-field="o.equipement_id.numero_serie"/></td>
                            </tr>
                            <tr>
                                <th>Date prévue</th>
                                <td><span t-field="o.date_prevue"/></td>
                            </tr>
                            <tr>
                                <th>Date de réception</th>
                                <td><span t-field="o.date_reception"/></td>
                            </tr>
                            <tr>
                                <th>Équipe d'installation</th>
                                <td>
                                    <t t-foreach="o.technicien_ids" t-as="t">
                                        <span t-out="t.name"/><t t-if="not t_last">, </t>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <th>Garantie jusqu'au</th>
                                <td><span t-field="o.equipement_id.fin_garantie"/></td>
                            </tr>
                        </table>

                        <h4 class="mt-4">Étapes réalisées</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Étape</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Remarque</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.etape_ids" t-as="e">
                                    <tr>
                                        <td><span t-field="e.name"/></td>
                                        <td><span t-field="e.date_reelle"/></td>
                                        <td><span t-field="e.statut"/></td>
                                        <td><span t-field="e.note"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <p class="mt-3">
                            Avancement du dossier : <strong><span t-field="o.avancement"/> %</strong>
                        </p>

                        <p class="mt-4">
                            Le client reconnaît avoir réceptionné l'équipement désigné ci-dessus en bon état de fonctionnement et avoir été formé à son utilisation.
                        </p>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p><strong>Pour le CDT</strong></p>
                                <p>Nom et signature :</p>
                            </div>
                            <div class="col-6">
                                <p><strong>Pour le client</strong></p>
                                <p>Nom et signature :</p>
                                <p t-if="o.pv_signe"><em>Procès-verbal signé</em></p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>